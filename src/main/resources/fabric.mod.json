{
	"schemaVersion": 1,
	"id": "durability-warning",
	"version": "${version}",
	"name": "Durability Warning",
	"description": "Warns you when your tool's durability is running low!",
	"authors": [
		"DataGhost57"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/durabilitywarning",
		"sources": "https://github.com/dataghost57/durability-warning-26.3"
	},
	"license": "MIT",
	"icon": "assets/durability-warning/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.dw.durabilitywarning.DurabilityWarning"
		],
		"client": [
			"com.dw.durabilitywarning.client.DurabilityWarningClient"
		]
	},
	"mixins": [
		"durability-warning.mixins.json",
		{
			"config": "durability-warning.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}